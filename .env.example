# CertiTrack 360 — variables de entorno (SDD §18.2). Copie este archivo a «.env» y cambie lo que corresponda.
# Nunca suba el archivo «.env» al repositorio.

# --- Django
DJANGO_SECRET_KEY=cambie-esta-clave
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Cookies de sesión seguras (solo viajan por HTTPS). Por defecto: activas cuando DJANGO_DEBUG=0.
# En una red interna sin HTTPS, fíjelo en 0 o nadie podrá iniciar sesión.
# DJANGO_COOKIE_SECURE=0
# Solo si hay un proxy o túnel HTTPS delante (lo fija scripts/demo_remota.ps1): confiar en X-Forwarded-Proto
# DJANGO_BEHIND_PROXY=1
# Orígenes extra aceptados por CSRF, separados por comas (p. ej. https://certitrack.midominio.com)
# DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Base de datos: sqlite:///db.sqlite3 (desarrollo) o postgres://usuario:clave@host:5432/nombre (producción)
DATABASE_URL=sqlite:///db.sqlite3
# Solo para Docker Compose (la base «db» y la URL de «web» se arman con este valor)
POSTGRES_PASSWORD=cambie-esta-clave

# --- Archivos adjuntos (se guardan en disco local; nunca tienen URL pública)
# MEDIA_ROOT=media
MEDIA_MAX_UPLOAD_MB=10
ALLOWED_UPLOAD_EXTENSIONS=pdf,docx,xlsx,pptx,png,jpg,txt

# --- Alertas y urgencia: días antes del vencimiento en que se avisa (una vez por umbral). El mayor define «próximo» y el
#     segundo mayor, «crítico». Por defecto 5,2,1,0 (SDD del Sprint 2, RF-22): avisos a 5 días, 48 h, 24 h y el mismo día;
#     «crítico» sigue empezando a 2 días.
ALERT_THRESHOLDS_DAYS=5,2,1,0
# --- Código de los entregables: <prefijo>-<año de creación>-<número>, p. ej. CT-2026-00031 (de 1 a 10 letras o números)
CODIGO_PREFIJO=CT
# --- Entregas (RF-29): días que el acta de conformidad puede seguir pendiente antes de avisar al junior y al senior (una sola vez)
ACTA_DIAS_PENDIENTE=5
# --- Ficha de levantamiento (RF-30): máximo de entregables generados por confirmación de ficha
FICHA_MAX_ENTREGABLES=60
# --- Personal y asignación (RF-31): umbral de sobrecarga de entregables activos
CARGA_MAXIMA_ACTIVOS=8
# --- Buscador global (RF-36): máximo de resultados por grupo
BUSCADOR_LIMITE=20
# --- Sprint 3 ---------------------------------------------------------------------------------------------------
# Prioridad (RF-42): días para que un entregable normal de cliente Estratégico sea de prioridad Media
PRIORIDAD_DIAS_ESTRATEGICO=10
# Alerta de urgencia (RF-43): horario laboral (días 1 = lunes a 7, y horas); fuera de él la alerta se marca «fuera de horario»
HORARIO_LABORAL=1-5,09:00-18:00
# Correo de la alerta urgente: SOLO por un servidor de correo local. Vacío: no se envía correo
# EMAIL_HOST=
# EMAIL_PORT=25
# EMAIL_FROM=certitrack@localhost
# Facturación (RF-46): conector de solo lectura. El simulado lee una tabla del servidor local
FACTURACION_CONECTOR=apps.facturacion.conector.ConectorSimulado
# Extracción de datos (RF-48): programa Tesseract instalado en el servidor, idiomas, confianza mínima y páginas por documento
TESSERACT_CMD=tesseract
OCR_IDIOMAS=spa+eng
OCR_CONFIANZA_MINIMA=60
OCR_MAX_PAGINAS=10
# Plataforma independiente (RF-51): único origen externo permitido (vacío: ninguno) y bloqueo de intentos de ingreso
# FILEDOC_URL=
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MINUTOS=15
# Servidor de producción (manage.py servir)
SERVIDOR_PUERTO=8000
SERVIDOR_HILOS=8
# --- Consolidado del gerente: ventana de «próximos a vencer», en días
CONSOLIDADO_WINDOW_DAYS=7
# --- Cierre de sesión por inactividad, en minutos
SESSION_IDLE_MINUTES=60

# --- Asistente de lecciones aprendidas (fase 2). Ollama corre en el servidor local.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
EMBED_MODEL=nomic-embed-text
# Similitud mínima (0 a 1) para dar por relevante una lección; ajústela según el modelo de embeddings
ASSISTANT_MIN_SIMILARITY=0.5
